# Dependencies — rebuilt inside the Dockerfile
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output — recreated during docker build
.next
out

# Environment files — NEVER include secrets in the image
.env
.env.*
!.env.example

# Git
.git
.gitignore

# Docker itself
Dockerfile
.dockerignore

# Dev tooling — not needed in production
.vscode
.idea
*.log

# Tests — not needed in the production image
e2e
__tests__
coverage
test-results
playwright-report

# Documentation
docs
README.md
*.md

# CI/CD
.github

# Storybook
storybook-static
.storybook
