NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# URL empruntee par le SERVEUR Next.js pour joindre l'API (connexion, refresh).
# Sans prefixe NEXT_PUBLIC : elle ne doit jamais partir dans le bundle client.
#
# Pourquoi elle existe : NEXT_PUBLIC_API_URL est l'adresse EXTERNE. Un appel
# serveur-a-serveur qui l'emprunte ressort par Traefik, lequel ajoute un saut a
# X-Forwarded-For — Django enregistrait donc la passerelle Docker comme IP pour
# CHAQUE connexion, alors que les acces depuis le navigateur portaient la vraie
# adresse. Par le reseau interne, aucun proxy ne s'intercale.
#
# En production, pointer sur le service Django du reseau Docker, par exemple :
#   INTERNAL_API_URL=http://guiss_django:8000/api/v1
# Non posee, le code retombe sur NEXT_PUBLIC_API_URL : degrade, jamais casse.
INTERNAL_API_URL=http://localhost:8000/api/v1

NEXT_PUBLIC_ENABLE_API_MOCKING=false
NEXT_PUBLIC_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
ICD_CLIENT_ID=
ICD_CLIENT_SECRET=